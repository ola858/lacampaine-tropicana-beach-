<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Staff Portal | La Campaigne Tropicana</title><link rel="stylesheet" href="style.css"></head>
<body class="admin-body"><div class="admin-shell"><a class="brand" href="index.html"><span class="brand-mark">🌴</span><span>LACAMPAIGNE<small>TROPICANA STAFF PORTAL DEMO</small></span></a>
<div class="notice" style="margin:22px 0"><b>Important security notice:</b> This is a front-end demonstration only. It is not a secure administrator system. Do not use real passwords or store guest data here. A production staff portal needs server-side authentication, role permissions, a database, HTTPS and audit logs.</div>
<section class="admin-panel" id="login-panel" style="max-width:520px;margin:30px auto"><h1 style="font:500 2.2rem Georgia,serif;color:var(--navy)">Staff sign in</h1><p class="muted">Demo access for previewing the sample dashboard.</p><form id="login-form"><div class="field"><label for="staff-role">Role</label><select id="staff-role"><option value="manager">Manager</option><option value="admin">Administrator</option></select></div><div class="field" style="margin-top:14px"><label for="staff-code">Demo access code</label><input id="staff-code" type="password" required autocomplete="off" placeholder="Enter demo code"></div><button class="btn btn-dark" style="margin-top:20px;width:100%">Sign in to demo</button><p id="login-message" class="small" aria-live="polite"></p></form><p class="small muted">Demo codes: Manager <code>MANAGER-DEMO</code> · Administrator <code>ADMIN-DEMO</code>. These codes are public examples and provide no real security.</p><a class="text-link" href="index.html">← Back to public website</a></section>
<section class="admin-panel hidden" id="dashboard"><div class="admin-top"><div><span class="eyebrow">Staff workspace</span><h1 style="font:500 2.2rem Georgia,serif;color:var(--navy);margin:0">Welcome to the demo dashboard</h1><p class="muted" id="role-label"></p></div><button class="btn btn-dark" id="logout">Sign out</button></div>
<div class="admin-grid"><div class="admin-metric"><span class="muted">Enquiries</span><strong>—</strong><span class="small">Connect booking system</span></div><div class="admin-metric"><span class="muted">Room availability</span><strong>—</strong><span class="small">Connect property system</span></div><div class="admin-metric"><span class="muted">Guest messages</span><strong>—</strong><span class="small">Connect secure inbox</span></div></div>
<h2 style="font-size:1.8rem">Role permissions (demo)</h2><div id="permission-copy" class="amenity"></div><h3 style="color:var(--navy)">Launch checklist</h3><ul class="check-list"><li>Set up secure server-side authentication and password hashing.</li><li>Use separate admin and manager permissions on the server.</li><li>Connect a database and secure booking/enquiry workflow.</li><li>Enable HTTPS, rate limiting, backups and audit logs.</li><li>Never keep real credentials in HTML or JavaScript.</li></ul><p class="muted small">This dashboard does not read or change bookings and does not save staff sessions securely.</p></section>
</div><script>
const loginForm=document.getElementById('login-form');
loginForm.addEventListener('submit',e=>{e.preventDefault();const role=document.getElementById('staff-role').value;const code=document.getElementById('staff-code').value;const ok=(role==='manager'&&code==='MANAGER-DEMO')||(role==='admin'&&code==='ADMIN-DEMO');if(!ok){document.getElementById('login-message').textContent='Code not recognised. Use the demo code listed below the form.';return;}document.getElementById('login-panel').classList.add('hidden');document.getElementById('dashboard').classList.remove('hidden');document.getElementById('role-label').textContent='Signed in as demo '+role+'.';document.getElementById('permission-copy').innerHTML=role==='admin'?'<b>Administrator preview</b><p>Can preview the site-wide dashboard and technical launch checklist. Real permissions must be enforced on a server.</p>':'<b>Manager preview</b><p>Can preview operational metrics and the launch checklist. Real permissions must be enforced on a server.';});
document.getElementById('logout').addEventListener('click',()=>{document.getElementById('dashboard').classList.add('hidden');document.getElementById('login-panel').classList.remove('hidden');document.getElementById('staff-code').value='';document.getElementById('login-message').textContent='';});
</script></body></html>
